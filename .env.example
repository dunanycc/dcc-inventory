DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_YAHOO_ID=""
AUTH_YAHOO_SECRET=""
BOOTSTRAP_ADMIN_EMAILS="admin@example.com"
# Base URL used to build direct links in notification emails.
APP_URL="http://localhost:3016"
SMTP_USER=""
SMTP_PASSWORD=""
# Also gates the email magic-link sign-in provider - it's only offered when
# these are set. Optional overrides below - defaults assume Gmail SMTP
# (smtp.gmail.com:465).
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE=""
EMAIL_FROM="DCC Inventory <inventory@example.com>"
# Local OAuth callbacks:
# http://localhost:3016/api/auth/callback/google
# http://localhost:3016/api/auth/callback/yahoo
