generator client {
  provider   = "prisma-client"
  output     = "../app/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRATOR
  INVENTORY_MANAGER
  INVENTORY_USER
  READ_ONLY
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum StockUnit {
  CAN
  BOTTLE
  KEG
  EACH
  PACKAGE
  OTHER
}

enum InventoryMovementType {
  OPENING
  RECEIPT
  TRANSFER
  COUNT_ADJUSTMENT
}

enum StockRequestStatus {
  SUBMITTED
  PARTIALLY_GIVEN
  GIVEN
  CANCELLED
}

enum TransferStatus {
  COMPLETED
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique
  emailNormalized    String              @unique
  name               String?
  status             UserStatus          @default(ACTIVE)
  role               Role                @default(READ_ONLY)
  lastLoginAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  auditEvents        AuditEvent[]        @relation("AuditActor")
  inventoryMovements InventoryMovement[] @relation("InventoryMovementPoster")
  stockRequests      StockRequest[]      @relation("StockRequestRequester")
  transfersPosted    Transfer[]          @relation("TransferPoster")
  productNotes       ProductNote[]       @relation("ProductNoteAuthor")
  deliveriesRecorded Delivery[]          @relation("DeliveryRecorder")

  @@index([status, role])
}

model Category {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @unique
  nameNormalized String    @unique
  displayOrder   Int       @default(0)
  active         Boolean   @default(true)
  sourceSystem   String?
  sourceId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]

  @@unique([sourceSystem, sourceId])
  @@index([active, displayOrder])
}

model Product {
  id                          String              @id @default(uuid()) @db.Uuid
  legacyProductId             String?             @unique
  name                        String
  categoryId                  String              @db.Uuid
  displayOrder               Int                 @default(0)
  stockUnit                   StockUnit
  stockUnitLabel              String?
  allowFractionalStock        Boolean             @default(false)
  quantityScale               Int                 @default(0)
  packageSize                 String?
  purchaseUnit                String?
  unitsPerPurchaseUnit        Decimal?            @db.Decimal(12, 3)
  active                      Boolean             @default(true)
  starterShackRequestEligible Boolean             @default(false)
  sourceSystem                String?
  sourceId                    String?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  category                    Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  productLocations            ProductLocation[]
  inventoryMovements          InventoryMovement[]
  stockRequestLines           StockRequestLine[]
  transferLines               TransferLine[]
  notes                       ProductNote[]
  deliveryLines               DeliveryLine[]

  @@unique([sourceSystem, sourceId])
  @@index([categoryId, active, displayOrder])
}

model ProductNote {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  author    User     @relation("ProductNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt(sort: Desc)])
  @@index([authorId, createdAt])
}

model Location {
  id                String              @id @default(uuid()) @db.Uuid
  code              String              @unique
  name              String              @unique
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  productLocations  ProductLocation[]
  outgoingMovements InventoryMovement[] @relation("InventoryMovementSource")
  incomingMovements InventoryMovement[] @relation("InventoryMovementDestination")
  outgoingTransfers Transfer[]          @relation("TransferSource")
  incomingTransfers Transfer[]          @relation("TransferDestination")

  @@index([active, name])
}

model ProductLocation {
  productId         String   @db.Uuid
  locationId        String   @db.Uuid
  active            Boolean  @default(true)
  reviewRequired    Boolean  @default(false)
  lowStockThreshold Decimal? @db.Decimal(18, 6)
  sourceSystem      String?
  sourceId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location          Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([productId, locationId])
  @@unique([sourceSystem, sourceId])
  @@index([locationId, active])
  @@index([reviewRequired, active])
}

model InventoryMovement {
  id                    String                @id @default(uuid()) @db.Uuid
  type                  InventoryMovementType
  productId             String                @db.Uuid
  quantity              Decimal               @db.Decimal(18, 6)
  sourceLocationId      String?               @db.Uuid
  destinationLocationId String?               @db.Uuid
  occurredAt            DateTime
  postedById            String                @db.Uuid
  notes                 String?
  receiptLineId         String?               @unique @db.Uuid
  transferLineId        String?               @unique @db.Uuid
  countLineId           String?               @unique @db.Uuid
  sourceSystem          String?
  sourceId              String?
  createdAt             DateTime              @default(now())
  product               Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceLocation        Location?             @relation("InventoryMovementSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation   Location?             @relation("InventoryMovementDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  postedBy              User                  @relation("InventoryMovementPoster", fields: [postedById], references: [id], onDelete: Restrict)
  transferLine          TransferLine?         @relation(fields: [transferLineId], references: [id], onDelete: Restrict)
  deliveryLineId        String?               @unique @db.Uuid
  deliveryLine          DeliveryLine?         @relation(fields: [deliveryLineId], references: [id], onDelete: Restrict)

  @@unique([sourceSystem, sourceId])
  @@index([productId])
  @@index([destinationLocationId, productId])
  @@index([sourceLocationId, productId])
  @@index([occurredAt, id])
  @@index([postedById, occurredAt])
}

model Vendor {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  nameNormalized String     @unique
  displayOrder   Int        @default(0)
  active         Boolean    @default(true)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deliveries     Delivery[]

  @@index([active, displayOrder])
}

model Delivery {
  id           String         @id @default(uuid()) @db.Uuid
  vendorId     String         @db.Uuid
  deliveryDate DateTime       @db.Date
  notes        String?
  recordedById String         @db.Uuid
  recordedAt   DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sourceSystem String?
  sourceId     String?
  vendor       Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  recordedBy   User           @relation("DeliveryRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  lines        DeliveryLine[]

  @@unique([sourceSystem, sourceId])
  @@index([deliveryDate(sort: Desc), id])
  @@index([vendorId, deliveryDate])
}

model DeliveryLine {
  id                   String             @id @default(uuid()) @db.Uuid
  deliveryId           String             @db.Uuid
  productId            String             @db.Uuid
  quantity             Decimal            @db.Decimal(18, 6)
  entryQuantity        Decimal            @db.Decimal(18, 6)
  purchaseUnit         String?
  unitsPerPurchaseUnit Decimal?           @db.Decimal(12, 3)
  active               Boolean            @default(true)
  delivery             Delivery           @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  product              Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryMovement    InventoryMovement?

  @@unique([deliveryId, productId])
  @@index([deliveryId, active])
  @@index([productId])
}

model StockRequest {
  id            String             @id @default(uuid()) @db.Uuid
  requestedAt   DateTime           @default(now())
  status        StockRequestStatus @default(SUBMITTED)
  notes         String?
  requestedById String             @db.Uuid
  createdAt     DateTime           @default(now())
  completedAt   DateTime?
  sourceSystem  String?
  sourceId      String?
  requestedBy   User               @relation("StockRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  lines         StockRequestLine[]
  transfers     Transfer[]

  @@unique([sourceSystem, sourceId])
  @@index([requestedById, requestedAt])
  @@index([status, requestedAt])
}

model StockRequestLine {
  id                String         @id @default(uuid()) @db.Uuid
  stockRequestId    String         @db.Uuid
  productId         String         @db.Uuid
  requestedQuantity Decimal        @db.Decimal(18, 6)
  quantityGiven     Decimal        @default(0) @db.Decimal(18, 6)
  sourceSystem      String?
  sourceId          String?
  stockRequest      StockRequest   @relation(fields: [stockRequestId], references: [id], onDelete: Restrict)
  product           Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  transferLines     TransferLine[]

  @@unique([stockRequestId, productId])
  @@unique([sourceSystem, sourceId])
  @@index([productId])
}

model Transfer {
  id                    String         @id @default(uuid()) @db.Uuid
  stockRequestId        String         @db.Uuid
  sourceLocationId      String         @db.Uuid
  destinationLocationId String         @db.Uuid
  status                TransferStatus @default(COMPLETED)
  occurredAt            DateTime
  postedById            String         @db.Uuid
  notes                 String?
  completedAt           DateTime
  createdAt             DateTime       @default(now())
  stockRequest          StockRequest   @relation(fields: [stockRequestId], references: [id], onDelete: Restrict)
  sourceLocation        Location       @relation("TransferSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation   Location       @relation("TransferDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  postedBy              User           @relation("TransferPoster", fields: [postedById], references: [id], onDelete: Restrict)
  lines                 TransferLine[]

  @@index([stockRequestId, occurredAt])
  @@index([sourceLocationId, destinationLocationId, occurredAt])
  @@index([postedById, occurredAt])
}

model TransferLine {
  id                 String             @id @default(uuid()) @db.Uuid
  transferId         String             @db.Uuid
  stockRequestLineId String             @db.Uuid
  productId          String             @db.Uuid
  quantity           Decimal            @db.Decimal(18, 6)
  transfer           Transfer           @relation(fields: [transferId], references: [id], onDelete: Restrict)
  stockRequestLine   StockRequestLine   @relation(fields: [stockRequestLineId], references: [id], onDelete: Restrict)
  product            Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryMovement  InventoryMovement?

  @@unique([transferId, stockRequestLineId])
  @@index([stockRequestLineId])
  @@index([productId])
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid
  action        String
  entityType    String
  entityId      String
  before        Json?
  after         Json?
  reason        String?
  correlationId String?
  occurredAt    DateTime @default(now())
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([correlationId])
}
