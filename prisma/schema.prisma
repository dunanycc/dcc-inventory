generator client {
  provider   = "prisma-client"
  output     = "../app/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRATOR
  INVENTORY_MANAGER
  INVENTORY_USER
  READ_ONLY
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum StockUnit {
  CAN
  BOTTLE
  KEG
  EACH
  PACKAGE
  OTHER
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  email       String       @unique
  name        String?
  status      UserStatus   @default(ACTIVE)
  role        Role         @default(READ_ONLY)
  lastLoginAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  auditEvents AuditEvent[] @relation("AuditActor")

  @@index([status, role])
}

model Category {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique
  displayOrder Int       @default(0)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@index([active, displayOrder])
}

model Product {
  id                   String            @id @default(uuid()) @db.Uuid
  legacyProductId      String?           @unique
  name                 String
  categoryId           String            @db.Uuid
  stockUnit            StockUnit
  stockUnitLabel       String?
  allowFractionalStock Boolean           @default(false)
  quantityScale        Int               @default(0)
  packageSize          String?
  purchaseUnit         String?
  unitsPerPurchaseUnit Decimal?          @db.Decimal(12, 3)
  active               Boolean           @default(true)
  starterShackEligible Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  category             Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  productLocations     ProductLocation[]

  @@index([categoryId, active, name])
}

model Location {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @unique
  name             String            @unique
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  productLocations ProductLocation[]

  @@index([active, name])
}

model ProductLocation {
  productId         String   @db.Uuid
  locationId        String   @db.Uuid
  active            Boolean  @default(true)
  lowStockThreshold Decimal? @db.Decimal(18, 6)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location          Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([productId, locationId])
  @@index([locationId, active])
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid
  action        String
  entityType    String
  entityId      String
  before        Json?
  after         Json?
  reason        String?
  correlationId String?
  occurredAt    DateTime @default(now())
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([correlationId])
}
